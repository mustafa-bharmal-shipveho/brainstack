<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Warm recall daemon launchd job (S3).

  Holds one HybridRetriever (reranker loaded) and owns the embedded Qdrant
  store, so the Claude Code auto-recall hook, `recall query`, `recall
  reindex`, and recall-mcp all answer in tens of milliseconds instead of
  paying a cold embedder/Qdrant load on every fire.

  Install (normally done by install.sh --setup-daemon, not by hand):
    cp com.brainstack.recall-daemon.plist ~/Library/LaunchAgents/
    <substitute every __PLACEHOLDER__ below first>
    launchctl load ~/Library/LaunchAgents/com.brainstack.recall-daemon.plist

  Placeholders (all must be substituted — an unreplaced __PLACEHOLDER__
  produces a unit launchd silently refuses to run):
    __PYTHON_ABS__   absolute path to the venv's python3 (e.g.
                     /Users/you/orca/.../.venv/bin/python3)
    __REPO_DIR__     absolute path to the brainstack checkout (PYTHONPATH)
    __BRAIN_ROOT__   absolute path to the brain root (usually ~/.agent)
    __HOME__         the user's home directory

  Remove: ./install.sh --remove-daemon (unloads, deletes this file, then
  best-effort `recall serve --stop`).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.brainstack.recall-daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_ABS__</string>
        <string>-m</string>
        <string>recall.cli</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__REPO_DIR__</string>
        <key>BRAIN_ROOT</key>
        <string>__BRAIN_ROOT__</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>__REPO_DIR__/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__BRAIN_ROOT__/runtime/logs/recall-daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__BRAIN_ROOT__/runtime/logs/recall-daemon.stderr.log</string>
</dict>
</plist>
