#!/usr/bin/env bash
# brainstack-managed pre-commit hook — safe for install.sh to replace.
# Delete this marker line if you customise the hook and want upgrades to
# leave it alone.
#
# Pre-commit hook for the brain repo at ~/.agent/.
# Runs the redact.py scanner over staged files; blocks the commit on any hit.
#
# Install:
#   cp templates/pre-commit ~/.agent/.git/hooks/pre-commit
#   chmod +x ~/.agent/.git/hooks/pre-commit
set -euo pipefail

BRAIN_ROOT="${BRAIN_ROOT:-$HOME/.agent}"

if [ ! -f "$BRAIN_ROOT/tools/redact.py" ]; then
    echo "pre-commit: redact.py not found at $BRAIN_ROOT/tools/" >&2
    exit 0  # don't block if framework is mid-upgrade
fi

# Pick a Python that's >= 3.10
PYTHON_BIN="${PYTHON_BIN:-python3}"
if ! "$PYTHON_BIN" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    for cand in python3.13 python3.12 python3.11 python3.10; do
        if command -v "$cand" >/dev/null; then
            PYTHON_BIN="$cand"
            break
        fi
    done
fi

# Scan ONLY what is staged.
#
# This used to scan the whole brain, which made the hook all-or-nothing:
# a single false positive in any file — even one nobody was committing —
# blocked every commit, so sync.sh could never push anything. Combined
# with the same bug in sync.sh's trufflehog gate, a month of memories
# silently never reached the remote.
#
# Scanning the staged set restores the hook's documented contract and
# lets sync.sh's per-file quarantine work: it unstages a suspect file,
# and the commit for everything else goes through.
# --diff-filter=d excludes only deletions. Naming the wanted statuses
# instead (ACM) silently skipped staged renames and type changes, so a
# commit that renamed a file AND added a secret to it went unscanned.
STAGED=()
while IFS= read -r -d '' f; do
    [ -f "$f" ] && STAGED+=("$BRAIN_ROOT/$f")
done < <(git diff --cached --name-only --diff-filter=d -z)

if [ "${#STAGED[@]}" -eq 0 ]; then
    exit 0
fi

# --pattern-root keeps redact-private.txt loading from the brain even
# though the targets are individual files.
"$PYTHON_BIN" "$BRAIN_ROOT/tools/redact.py" \
    --pattern-root "$BRAIN_ROOT" "${STAGED[@]}"
